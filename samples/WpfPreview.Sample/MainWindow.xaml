<Window x:Class="WpfPreview.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Preview · 独立接入示例" Width="680" Height="440"
        Background="#171D27" Foreground="#E2EAF7" FontFamily="Microsoft YaHei">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" Text="让 WPF 界面成为开发上下文" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,12,0,0" Text="在浏览器中框选、批注，并定位到这个项目的 XAML。" Foreground="#96A9C0" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,28" Padding="24" CornerRadius="12" Background="#242F40">
            <StackPanel>
                <TextBlock Text="这是独立的 WPF 应用" FontSize="17" />
                <TextBlock Margin="0,10,0,20" Foreground="#B5C6DA" TextWrapping="Wrap"
                           Text="仅引用预览库，无需 Quicker、Headless、WebView 或前端构建服务。" />
                <TextBox x:Name="ExampleInput" Text="可以在真实窗口里修改这段文字" Padding="10" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2" Text="预览地址：http://127.0.0.1:5198/wpf-preview/（端口可配置）" Foreground="#7DD3FC" />
    </Grid>
</Window>
